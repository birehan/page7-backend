# Copy to .env for local development. This file is gitignored — real values never
# go here in a commit; .env.example stays the only tracked env template.

APP_ENV=development

# See compose/docker-compose.yml for the matching local Postgres service.
# API / acceptance data: database `pgblank` (volume-backed).
# Pytest (incl. alembic downgrade-to-base): database `pgblank_test` — created by
# compose init / `just ensure-test-db`. Never point pytest at `pgblank`.
DATABASE__URL=postgresql+asyncpg://pgblank:pgblank@localhost:5544/pgblank

# --- Cloud Deploy / Secret Manager (not loaded by the app locally) ---
# Staging Cloud SQL TCP URL → create-secrets.sh writes Secret Manager DATABASE_URL
# (rewritten to Unix socket for Cloud Run). Prod:
# CLOUD_SQL_DATABASE_URL=postgresql+asyncpg://USER:PASS@34.18.237.66:5432/page7-staging-db
# DATABASE_URL_PROD=postgresql+asyncpg://USER:PASS@34.18.237.66:5432/page7-prod-db

# Required (fails closed) outside APP_ENV=development. APP_ENCRYPTION_KEY_CURRENT
# names which aliased key below new encryptions use; a row decrypts under
# whichever alias it was written with, so keep an old alias configured until
# every row referencing it has been re-encrypted (architecture/05 §4). Generate
# a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ENCRYPTION_KEY__k1=
APP_ENCRYPTION_KEY_CURRENT=k1

# Page7 frontend origins (cookie + CORS). Local Next on :3000; prod is page7.io.
# Include every browser origin that will call this API with credentials.
CORS__ALLOWED_ORIGINS=["http://localhost:3000","https://page7-git-staging-birehans-projects.vercel.app","https://page7.io"]
# Where invite/reset/Google OAuth success redirects land (Page7, not pgblank-web).
AUTH__FRONTEND_URL=http://localhost:3000
# Production: AUTH__FRONTEND_URL=https://page7.io
# lax (default) for same-origin Cloudflare Workers; none only for the Firebase
# cross-site fallback (requires Secure cookies — rejected in development).
AUTH__COOKIE_SAMESITE=lax
# Google OIDC (all three required to enable "Continue with Google").
# Google Console: authorized JS origins = http://localhost:3000 + https://page7.io
# Authorized redirect URI = AUTH__GOOGLE_REDIRECT_URI below (API callback, not Page7).
# AUTH__GOOGLE_CLIENT_ID=
# AUTH__GOOGLE_CLIENT_SECRET=
# AUTH__GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback

# "auto" → console in development/testing, resend otherwise.
# "smtp" → Hostinger (or any) SMTP — works in local envs too (for real sends).
# Verify mailbox password in Hostinger, then set EMAIL__SMTP_PASSWORD.
EMAIL__PROVIDER=smtp
EMAIL__FROM_ADDRESS=Page7 <contact@page7.io>
EMAIL__SMTP_HOST=smtp.hostinger.com
EMAIL__SMTP_PORT=465
EMAIL__SMTP_USERNAME=contact@page7.io
EMAIL__SMTP_PASSWORD=
EMAIL__SMTP_USE_TLS=true
EMAIL__RESEND_API_KEY=

# "auto" resolves to LocalStorage under development/testing, R2 otherwise
# (integrations/storage). public_base_url is the browser-reachable CDN origin
# for public media (a custom domain on the R2 bucket — never r2.dev).
STORAGE__PROVIDER=auto
STORAGE__PUBLIC_BUCKET=pgblank
STORAGE__PUBLIC_BASE_URL=http://localhost:8000
STORAGE__LOCAL_ROOT=/tmp/pgblank-storage
STORAGE__R2_ACCOUNT_ID=
STORAGE__R2_ACCESS_KEY_ID=
STORAGE__R2_SECRET_ACCESS_KEY=
# Optional. Invoice PDF writes are not implemented yet — leave unset until a
# private bucket exists. Creating one is a deploy-time ops step, not required
# for API boot.
STORAGE__PRIVATE_BUCKET=

# Unsplash access key for stock search/import (integrations/stock). Required
# once STORAGE__PROVIDER resolves to R2 in a non-local environment that serves
# stock; LocalStorage + FakeStockProvider cover CI without it.
STOCK__PROVIDER=auto
STOCK__UNSPLASH_ACCESS_KEY=

# "auto" resolves to FakeLLMProvider under development/testing (or when API keys
# are unset); real adapters otherwise (integrations/llm).
# For local manual testing against real OpenAI, set LLM__PROVIDER=openai —
# "auto" always fakes in development even when keys are set.
# Task defaults: OpenAI-only — creative/plan/brand_research/insight → gpt-5.5;
# classification/reply/transform/alt_text → gpt-5.6-luna. No Anthropic/Claude.
# IMAGEGEN__ is separate (Fal) and not controlled by LLM__*.
LLM__PROVIDER=openai
LLM__OPENAI_API_KEY=
# LLM__ANTHROPIC_API_KEY=  # unused by default tasks

# "auto" resolves to FakeImageGenerationProvider under development/testing (or
# when IMAGEGEN__API_KEY is unset); real FalImageProvider otherwise. For local
# manual testing against fal set IMAGEGEN__PROVIDER=fal and IMAGEGEN__API_KEY
# (fal_client also accepts FAL_KEY — the factory exports it from IMAGEGEN__).
IMAGEGEN__PROVIDER=auto
IMAGEGEN__API_KEY=

# Zernio social accounts (integrations/social). secret_ref in
# zernio_credentials is the env var name itself (ZERNIO_API_KEY__t1).
# Legacy single-underscore names (ZERNIO_API_KEY_1) are accepted only by
# live tests' fallback lookup — the running app and CredentialPool need the
# double-underscore form. Export both or rename before a live publish run.
# "auto" resolves to FakeSocialProvider when no non-placeholder
# ZERNIO_API_KEY__* is set; real ZernioClient otherwise (any APP_ENV).
# Set SOCIAL__PROVIDER=fake to force the in-memory adapter, or
# SOCIAL__PROVIDER=zernio to require real keys (fails if missing).
# Live publish also requires RUN_LIVE_TESTS=1 and RUN_LIVE_PUBLISH=1.
#
# N free keys: add aliases + ZERNIO_API_KEY__{alias} (+ webhook secret). Each
# free key holds max_accounts=2 connected accounts; when full, connect fails
# over to the next healthy key. Rows upsert from aliases (no migration for t4+).
ZERNIO_CREDENTIAL_ALIASES=t1,t2,t3,t4
ZERNIO_API_KEY__t1=
ZERNIO_API_KEY__t2=
ZERNIO_API_KEY__t3=
ZERNIO_API_KEY__t4=
ZERNIO_WEBHOOK_SECRET__t1=
ZERNIO_WEBHOOK_SECRET__t2=
ZERNIO_WEBHOOK_SECRET__t3=
ZERNIO_WEBHOOK_SECRET__t4=
SOCIAL__PROVIDER=auto
SOCIAL__FILL_TO_TIER=3
SOCIAL__MAX_ACCOUNTS_PER_CREDENTIAL=2
SOCIAL__MAX_PROFILES=100
SOCIAL__CALLBACK_REDIRECT_ORIGIN=http://localhost:3000
SOCIAL__OAUTH_CALLBACK_URL=http://localhost:8000/v1/integrations/zernio/callback

# Brand research / website extraction (architecture/08). Env prefix RESEARCH__.
# approach=fast (default): homepage HTML + structured LLM, no web_search stage.
# approach=full: legacy FetchExtract + SearchAugmented merge path.
RESEARCH__APPROACH=fast
RESEARCH__DAILY_CAP_PER_BRAND=10
RESEARCH__PAGE_CAP=5

# Unset by default — Sentry/OTel stay off until a real project/collector exists.
OBSERVABILITY__SENTRY_DSN=
OBSERVABILITY__OTEL_ENABLED=false

# Billing (Phase 13). Env prefix BILLING__.
# Seller VAT is pgblank.ai's own 15-digit registration, snapshotted onto invoices.
BILLING__SELLER_VAT_NUMBER=300000000000003
BILLING__DEFAULT_VAT_RATE=0.15
OBSERVABILITY__SENTRY_DSN=
OBSERVABILITY__OTEL_ENABLED=false
